{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WFMHub 2",
  "version": "0.2.0",
  "identifier": "com.wfmhub.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir web build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "WFMHub 2 \u2014 Workforce Intelligence",
        "width": 1480,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/wfmhub-engine"
    ],
    "resources": {
      "../packaging/duckdb_extensions/ducklake.duckdb_extension": "duckdb_extensions/ducklake.duckdb_extension"
    }
  }
}
